                <mxCell id="27" value="Each step adds one small upgrade. Skip a step and you have a toy. Do all of them and you have a real product people pay for." style="text;html=1;strokeColor=none;fillColor=none;fontColor=#616161;fontSize=10;fontStyle=2;align=center;" parent="3" vertex="1">
                    <mxGeometry y="1779" width="600" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="vibe1" value="smart, but&lt;br&gt;can&amp;apos;t do laundry" style="text;html=1;align=center;verticalAlign=middle;fillColor=#FFFDE7;strokeColor=#FBC02D;strokeWidth=1;fontSize=9;fontStyle=2;fontColor=#5D4037;rounded=1;rotation=-4;shadow=1;" parent="3" vertex="1">
                    <mxGeometry x="610" y="125" width="100" height="35" as="geometry"/>
                </mxCell>
                <mxCell id="vibe4" value="uh oh, it has&lt;br&gt;API keys now" style="text;html=1;align=center;verticalAlign=middle;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=1;fontSize=9;fontStyle=2;fontColor=#0D47A1;rounded=1;rotation=5;shadow=1;" parent="3" vertex="1">
