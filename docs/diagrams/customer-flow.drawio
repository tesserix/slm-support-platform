                <mxCell id="s1" value="1. Types&#xa;&quot;where is&#xa;my order?&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#388E3C;fontSize=10;align=center;" parent="1" vertex="1">
