ENV=dev
HTTP_PORT=8090

# Otto's MongoDB. slm-router reads the conversations + messages
# collections (change stream) and posts assistant replies back.
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=otto

# Tenant routes (system prompt path, RAG namespace, MCP servers,
# escalation policy). Mounted from a ConfigMap in cluster.
ROUTES_FILE=./routes.example.yaml
ROUTE_RELOAD_INTERVAL=60s

# SLM inference + retrieval services.
INFERENCE_URL=http://localhost:8000
EMBEDDER_URL=http://localhost:8001
RERANKER_URL=http://localhost:8002

# pgvector store (read-only; ingestion writes from a separate CronJob).
VECTOR_DB_DSN=postgres://slm_router:password@localhost:5432/support?sslmode=disable
