ENV=dev
HTTP_PORT=8089

MONGO_URL=mongodb://localhost:27017
MONGO_DATABASE=otto

# Any random >=32 byte hex/base64 string is fine for local dev.
CUSTOMER_SESSION_SECRET=dev-insecure-session-secret-change-me
CUSTOMER_SESSION_COOKIE=otto_session
CUSTOMER_COOKIE_DOMAIN=
CUSTOMER_COOKIE_SECURE=false

# Shared with the Next.js proxy — prevents direct public traffic on REST.
INTERNAL_AUTH_SECRET=dev-insecure-internal-secret-change-me

CORS_ALLOWED_ORIGINS=http://localhost:3200,http://localhost:3001
